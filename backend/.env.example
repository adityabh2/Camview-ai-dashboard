# Copy this file to backend/.env and fill it in, OR just use the dashboard's
# Settings > "Connect to Camview" form, which writes backend/.env for you.
# Without CAMVIEW_API_KEY the dashboard only shows SAMPLE (fake) data.
# Full explanation of every setting: README.md section 6.

# ---- Where to fetch alarms from -------------------------------------------
# Full listAlarms URL. No /api prefix (that returns 500 "no handler").
# Prod: https://default.prod.api.camviewai.com/alarms/listAlarms
# Dev:  https://default.dev.api.camviewai.com/alarms/listAlarms
CAMVIEW_API_URL=https://default.prod.api.camviewai.com/alarms/listAlarms

# The raw scoped API key (sent as "Authorization: <key>", no "Bearer").
CAMVIEW_API_KEY=QjuXwPUVowin5zlYOD0H464z9BxzUBEUTUsE1LqtqWw=

# Numeric projectId to load by default in Live Mode (can be changed in Settings).
CAMVIEW_PROJECT_ID=1

# The exam's own project code per Camview project id, shown everywhere instead of the number
# (Camview's API sends only the number). Comma-separated id:code pairs; also editable in Settings.
CAMVIEW_PROJECT_CODES=
# When alerts reach the client: arrival = the moment Camview sends them (no VALID needed; INVALID/EXCEPTION
# withdraws them) · valid = only after Camview or an operator marks them VALID
CAMVIEW_DELIVERY_TRIGGER=arrival
# Old project ids that must never be monitored or listed (their auto-built data is removed at start-up)
CAMVIEW_EXCLUDED_PROJECTS=

# ---- Optional display labels ----------------------------------------------
# Names for numeric alarmType IDs, e.g. 5:Mobile Phone Detected,6:Impersonation
CAMVIEW_ALARM_TYPE_NAMES=
# Names for numeric priority values (default shown).
CAMVIEW_PRIORITY_LABELS=1:critical,2:high,3:medium,4:low
# Camera field to group "Halls" by (auto-detected if blank: hall, location, name...).
CAMVIEW_HALL_FIELD=

CAMVIEW_TIMEOUT=15

# ---- KPIs & Reports page ----------------------------------------------------
# How many pages of 100 alarms to read from Camview per report (live mode).
CAMVIEW_KPI_MAX_PAGES=10
# 1 = ask Camview for the exact time range via startTime/endTime (history table).
CAMVIEW_KPI_USE_HISTORY=0
PORT=5000

# ---- CAMVIEW Command Center ---------------------------------------------------
# Data mode: demo (generated demo data, separate camview-demo.db, always labelled
# DEMO) or live (real Camview data, camview.db). Blank = live if a key is set.
CAMVIEW_MODE=demo
# Live mode, first start only: the Super Admin account that gets created.
# If the password is blank a random one is printed once in the console.
CAMVIEW_ADMIN_EMAIL=admin@camview.local
CAMVIEW_ADMIN_PASSWORD=
# Session signing key. Generated automatically on first start if blank.
CAMVIEW_SECRET_KEY=
# Live operations working window = pages x 100 newest alarms; server cache seconds.
CAMVIEW_WINDOW_PAGES=3
CAMVIEW_CACHE_SECONDS=150
# Set to 1 behind HTTPS so session cookies are Secure-only.
CAMVIEW_SECURE_COOKIES=0
# Feature flags (V2 features stay off until their backend exists).
ENABLE_CLIENT_PORTAL=1
ENABLE_CLIENT_SHARING=1
ENABLE_AI=0
ENABLE_INCIDENTS=0
ENABLE_REALTIME=0
ENABLE_MAP=0
