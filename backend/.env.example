# Copy this file to backend/.env and fill it in, OR just use the dashboard's
# Settings > "Connect to Camview" form, which writes backend/.env for you.
# Without CAMVIEW_API_KEY the dashboard only shows SAMPLE (fake) data.
# Full explanation of every setting: README.md section 6.

# ---- Where to fetch alarms from -------------------------------------------
# Full listAlarms URL. No /api prefix (that returns 500 "no handler").
# Prod: https://default.prod.api.camviewai.com/alarms/listAlarms
# Dev:  https://default.dev.api.camviewai.com/alarms/listAlarms
CAMVIEW_API_URL=https://default.prod.api.camviewai.com/alarms/listAlarms

# The raw scoped API key (sent as "Authorization: <key>"), OR a user login token written as
# "Bearer <token>" (sent with the Bearer prefix; login tokens expire after about an hour).
CAMVIEW_API_KEY=

# Key for the Project Lookup API (POST /api/project/listProjectsByClientProjectId), used by
# Settings > Monitored projects > "Add projects by project code". Raw key or "Bearer <token>".
# Blank = CAMVIEW_API_KEY is used.
CAMVIEW_PROJECT_API_KEY=
# Optional: override the lookup URL (default: derived from CAMVIEW_API_URL).
CAMVIEW_PROJECT_LOOKUP_URL=

# Numeric projectId to load by default in Live Mode (can be changed in Settings).
CAMVIEW_PROJECT_ID=1

# The exam's own project code per Camview project id, shown everywhere instead of the number
# (Camview's API sends only the number). Comma-separated id:code pairs; also editable in Settings.
CAMVIEW_PROJECT_CODES=
# Clients see ONLY alerts the operations team marked VALID (core rule, cannot be switched off). The former
# "arrival" trigger is no longer honoured; leave this at valid.
CAMVIEW_DELIVERY_TRIGGER=valid
# Old project ids that must never be monitored or listed (their auto-built data is removed at start-up)
CAMVIEW_EXCLUDED_PROJECTS=

# ---- Optional display labels ----------------------------------------------
# Names for numeric alarmType IDs, e.g. 5:Mobile Phone Detected,6:Impersonation
CAMVIEW_ALARM_TYPE_NAMES=
# Names for numeric priority values (default shown).
CAMVIEW_PRIORITY_LABELS=1:critical,2:high,3:medium,4:low
# Camera field to group "Halls" by (auto-detected if blank: hall, location, name...).
CAMVIEW_HALL_FIELD=

CAMVIEW_TIMEOUT=15

# ---- KPIs & Reports page ----------------------------------------------------
# How many pages of 100 alarms to read from Camview per report (live mode).
CAMVIEW_KPI_MAX_PAGES=10
# 1 = ask Camview for the exact time range via startTime/endTime (history table).
CAMVIEW_KPI_USE_HISTORY=0
PORT=5000

# ---- CAMVIEW Command Center ---------------------------------------------------
# all (default) = every detection alert goes to its client on arrival; an administrator marks INVALID to take
# one back (it stays in the system). valid = clients see only alerts an operator marked VALID.
CAMVIEW_CLIENT_DELIVERY=all
# An alert is LIVE while its own latest occurrence is at most this many minutes old.
CAMVIEW_LIVE_MINUTES=30
# Reports shared with clients automatically: daily at this local hour, and once when a project ends.
CAMVIEW_AUTO_REPORT_DAILY=1
CAMVIEW_AUTO_REPORT_ON_END=1
CAMVIEW_DAILY_REPORT_HOUR=20
# Local time zone for the daily report, minutes from UTC (330 = India).
CAMVIEW_REPORT_TZ_OFFSET=330
# 1 = no sign-in screen: the app runs as the built-in Super Admin. Single-user installs on THIS computer only
# (docker-compose.local.yml sets it and publishes the port on 127.0.0.1). Keep 0 on any shared server.
CAMVIEW_NO_LOGIN=0
# Data mode: demo (generated demo data, separate camview-demo.db, always labelled
# DEMO) or live (real Camview data, camview.db). Blank = live if a key is set.
CAMVIEW_MODE=demo
# Live mode, first start only: the Super Admin account that gets created.
# If the password is blank a random one is written to initial-admin-password.txt next to the database
# (never to the log) — sign in, change it, delete the file.
CAMVIEW_ADMIN_EMAIL=admin@camview.local
CAMVIEW_ADMIN_PASSWORD=
# Session signing key (48+ random characters). REQUIRED in production. If blank in live mode, one is generated
# once and kept in .session-secret next to the database (stable across restarts); if that file cannot be
# written the server refuses to start.
CAMVIEW_SECRET_KEY=
# Live operations working window = pages x 100 newest alarms; server cache seconds.
CAMVIEW_WINDOW_PAGES=3
CAMVIEW_CACHE_SECONDS=150
# Session cookies are always HttpOnly + SameSite=Lax, and Secure on every HTTPS request. 1 = Secure always.
CAMVIEW_SECURE_COOKIES=0
# Behind a TLS-terminating proxy: 1 = trust X-Forwarded-Proto/For (so HTTPS is recognised).
CAMVIEW_TRUST_PROXY=0
# Maximum parallel calls to Camview across refreshes and project discovery (protects Camview).
CAMVIEW_MAX_CONCURRENCY=6
# Evidence: redirect (browser loads the freshly signed link) or proxy (streamed through this server).
CAMVIEW_MEDIA_MODE=redirect
# Feature flags (V2 features stay off until their backend exists).
ENABLE_CLIENT_PORTAL=1
ENABLE_CLIENT_SHARING=1
ENABLE_AI=0
ENABLE_INCIDENTS=0
ENABLE_REALTIME=0
ENABLE_MAP=0
